{
  "identifier": "default",
  "description": "Default capability for TimeWrite main and feature windows",
  "windows": ["main", "world", "history", "summary", "ai-toolbox"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    { "identifier": "fs:allow-read", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-write", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-exists", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-mkdir", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-remove", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-rename", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-copy-file", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-read-text-file", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-write-text-file", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-read-dir", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    { "identifier": "fs:allow-stat", "scope": ["$APPDATA/**", "$RESOURCE/**"] },
    "deep-link:default",
    "http:default"
  ]
}
