{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeWrite",
  "version": "1.6.0",
  "identifier": "com.ukcoder.timewrite",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "智写时光 TimeWrite",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; media-src 'self' asset: data: blob: http://asset.localhost https://asset.localhost; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; connect-src 'self' ipc: http://ipc.localhost https://asset.localhost https://api.github.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "dialog": null,
    "fs": null,
    "updater": {
      "endpoints": [
        "https://github.com/WangYajun369/ai-writing-platform/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEQzNFMkQzNzQ1RjJCRDcKUldUWEsxOTAwK0xETFRjMXpxN1BTQXhDZ3ZSb25JNDEwUWdMUjNpTnk5QklJaXlGSnhHVU83NVQK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.ukcoder.timewrite"
        ]
      }
    }
  }
}
